# OpenWeather API Key
# Get yours at: https://home.openweathermap.org
OPENWEATHER_API_KEY=your_api_key_here

# Phoenix Secret Key Base
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=your_secret_key_base_here

# Phoenix Host (domain name your app will run on)
PHX_HOST=localhost

# Application Port
PORT=4000
